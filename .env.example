# ---------------------------------------------------------------------------
# Bay Area Concert Radar — environment
# Copy to .env.local for local dev, or set these in your host (e.g. Vercel).
# The site renders with built-in sample data even if NOTHING here is set.
# ---------------------------------------------------------------------------

# Supabase — persistence for concerts + subscribers.
# Public (browser-safe) keys:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Used by the scrape/alert jobs to write data and
# by the site to read listings. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Ticketmaster Discovery API key — the concert data source.
# Free key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Optional: scrape the built-in sample dataset into the DB (set to 1 to enable).
SEED_CONCERTS=

# Resend — email delivery for alerts. https://resend.com
# If unset, alert emails are logged to the server console instead of sent.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding address if unset.
ALERT_FROM_EMAIL="Concert Radar <onboarding@resend.dev>"

# Shared secret protecting the cron endpoints (/api/cron/*).
# Vercel Cron sends this automatically as a Bearer token.
CRON_SECRET=

# Public site URL, used to build links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
